# Environment variables read by the backend (backend/app/config.py).
# Every value below is the default. The application starts with none of them set.
# Retrieval needs no credentials. Optional summaries require a private API key.
# This example contains no real secrets. Never commit a populated .env file.

# --- server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# Interactive API docs at /docs. Off by default because the page loads scripts from a CDN.
ENABLE_API_DOCS=false

# --- retrieval
# Set to false to run keyword-only (also the automatic fallback if the model cannot load).
SEMANTIC_ENABLED=true
KEYWORD_BIGRAMS=true
KEYWORD_STEMMING=false
KEYWORD_TOP_K=10
SEMANTIC_TOP_K=10
RRF_K=60
# Main matches: the request chooses top_k=3 or top_k=5 (default 3).
# The old MAX_USEFUL_RESULTS setting is no longer used.
MAX_RELATED_RESULTS=3
# Threads PyTorch may use per search. Keep at 1 on a 1-vCPU task.
TORCH_NUM_THREADS=1

# --- input limits
SUBJECT_MAX_CHARS=200
DESCRIPTION_MAX_CHARS=4000
PRODUCT_MAX_CHARS=80
ERROR_DETAIL_MAX_CHARS=300
MAX_BODY_BYTES=65536
MIN_MEANINGFUL_TERMS=2

# --- protection of expensive work
MAX_CONCURRENT_SEARCHES=4
SEARCH_QUEUE_TIMEOUT_SECONDS=5

# --- optional LLM summaries (backend only; never use VITE_ for these)
# Leave blank to keep summaries disabled while search remains usable.
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-4o-mini
SUMMARY_TIMEOUT_SECONDS=35
SUMMARY_MAX_INPUT_CHARS=30000
MAX_CONCURRENT_SUMMARIES=2
SUMMARY_TOKEN_TTL_SECONDS=900
# Use the same random secret (at least 32 random bytes) on every replica.
# Blank: a process-local random key; old result tokens become invalid on restart.
SUMMARY_SIGNING_KEY=

# --- file locations (set for you inside the container image)
# TICKETS_PATH=../starter_kit/data/tickets.json
# EXAMPLES_PATH=../starter_kit/data/new_tickets_example.json
# MODEL_DIR=backend/models/all-MiniLM-L6-v2
# ARTIFACTS_DIR=backend/artifacts
# FRONTEND_DIST=frontend/dist

# --- ticket storage
# json: the seed file plus a JSON store in DATA_DIR (local demonstrations).
# postgresql: every ticket comes from PostgreSQL. There is no fallback to the JSON data.
TICKET_STORE=json
# Required when TICKET_STORE=postgresql. Keep the real value out of source control and logs:
# put it in your shell, a secrets manager or an untracked .env file.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOAD_BATCH_SIZE=500
# 0 = off. With several app instances, set e.g. 60 so each picks up saves made on the others.
INDEX_REFRESH_INTERVAL_SECONDS=0
# Writable folder for saved tickets (JSON mode) and the embedding cache.
# DATA_DIR=backend/state

# --- saving resolved tickets
SAVE_ENABLED=true
MAX_SAVED_TICKETS=2000
# Only set this when a trusted authenticating proxy sets the header and strips it from client requests.
IDENTITY_HEADER=
ESCALATION_EMAIL=ticketexpert@solar.com
